test  <- seq(1,nrow(iris),by=1)[which(!((1:nrow(iris)) %in% train))]#
#
X.train <- iris[train,-5]#
Class.train <- iris[train,5]#
X.test <- iris[test,-5]#
Class.test <- iris[test,5]#
#
#density estimation#
