summary(iris.cla,parameters=TRUE)
summary(iris.cla, newdata=X.test, newclass=Class.test)
plot(iris.cla,what= "classification")
quartz()
plot(iris.cla,what= "classification", newdata = X.test)
plot(iris.cla,what= "train&test", newdata = X.test)
plot(iris.cla,what= "classification", dimens=4)
plot(iris.cla,what= "classification", dimens=3)
data("iris")#
#
#split of the data into a training set and a test set#
Iris <- split(p=2/3, Dataset = iris, class = 5)#
#
#estimation of the gaussian finite mixture based on the training set#
iris.est <- REBMIX(model="REBMVNORM", Dataset=Iris@train, Preprocessing = "Parzen window", cmax =10, Criterion ="BIC")#
#
#classification#
iris.cla <- RCLSMIX(model="RCLSMVNORM", x= list(iris.est), Dataset= Iris@test, Zt= Iris@Zt)
plot(iris.cla)
plot(iris.cla, nrow=3, ncol=2)
